{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "Core Notification Orchestrator Service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {

    "start":
    "node src/index.js",

    "worker":
    "node src/workers/notificationWorker.js",

    "dev":
    "nodemon src/index.js",

    "dev:worker":
    "nodemon src/workers/notificationWorker.js",


    "test":
    "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",

    "test:unit":
    "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",

    "test:integration":
    "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",

    "test:e2e":
    "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e"

    },
  "dependencies": {
    "express": "^5.2.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "jest-environment-node": "^30.4.1",
    "mysql2": "^3.22.5",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "redis": "^6.0.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1"
  }
}
